# Provision one user per device_uid after enrollment:
#   mosquitto_passwd -b /mosquitto/config/passwd <device_uid> <one-time-token>
# Tokens must be generated by the backend /device-ingest/provision endpoint.

user ve360_ingest
topic readwrite ve360/#

# Each device may only touch its own station's topics.
pattern read ve360/stations/%u/#
pattern write ve360/stations/%u/#
