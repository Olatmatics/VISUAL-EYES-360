/*
 * VISUAL EYES 360 - BOARD 2: TANK MONITOR
 * Bench prototype. ESP32 DevKit v1 + HC-SR04 + DHT11 + lid switch.
 * Serial 115200. NOT intrinsically safe.
 *
 * Everything can be typed in Serial Monitor — no code editing needed at the bench.
 *
 * SETUP COMMANDS (saved in ESP32 Preferences, survive power cycle):
 *   SET WIFI ssid|password
 *   SET BACKEND http://172.25.0.37:8000
 *   SET DEVICE TANK-DEV-01
 *   SET TANK <tank id copied from Device ID Directory>
 *   SET HEIGHT <tank height in cm>
 *   SET CAPACITY <tank capacity in litres>
 *   CONFIG | JSON ON|OFF | REBOOT
 *
 * TEST COMMANDS:
 *   HELP | READ | SEND | STATUS | LID
 *
 * HC-SR04 ECHO is 5 V -> use a 2k2/3k3 divider to ESP32 GPIO 18.
 *
 * LEDs: GPIO2 (onboard) = Wi-Fi status. Steady ON when connected, slow blink
 * while connecting. GPIO22 + 220R = backend activity, blinks very fast on
 * every telemetry send and response.
 */

#include <WiFi.h>
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <Preferences.h>
#include <DHT.h>
#include <math.h>

Preferences prefs;

// Factory defaults. Change from Serial with SET ... — do not edit this file.
const char* DEF_WIFI_SSID = "cypher";
const char* DEF_WIFI_PASS = "12345678";
const char* DEF_BACKEND   = "http://172.25.0.37:8000";
const char* DEF_DEVICE    = "TANK-DEV-01";
const char* DEF_TANK      = "YOUR_TANK_ID";
const char* FIRMWARE      = "ve360-tank-bench-1.1";

#define WIFI_LED_PIN 2      // onboard LED: Wi-Fi status
#define COMM_LED_PIN 22     // add LED + 220R to GND: backend activity
#define TRIG_PIN  5
#define ECHO_PIN  18
#define DHT_PIN   4
#define LIMIT_PIN 19
#define DHTTYPE   DHT11
DHT dht(DHT_PIN, DHTTYPE);

String wifiSsid, wifiPass, backendUrl, deviceUid, tankId;
float tankHeightCm = 200.0;
float tankCapacityL = 30000.0;
bool jsonEcho = true;

unsigned long commUntil = 0;
unsigned long commToggleAt = 0;
unsigned long wifiBlinkAt = 0;
bool commLedOn = false;
bool wifiLedOn = false;

unsigned long eventNo = 0;
unsigned long lastSend = 0;
unsigned long lastWifiRetry = 0;
bool wifiWasConnected = false;
float levelCm = 0;
float volumeL = 0;
float temperatureC = 0;
float humidityPct = 0;
bool lidOpen = false;

String cfg(const char* key, const char* def) {
  String v = prefs.getString(key, "");
  return v.length() ? v : String(def);
}
void saveCfg(const char* key, const String& v) { prefs.putString(key, v); }

// ---- LED status helpers -----------------------------------------------------
void markBackendActivity(unsigned long holdMs = 700) {
  unsigned long now = millis();
  commUntil = now + holdMs;
  commToggleAt = now + 40;
  commLedOn = true;
  digitalWrite(COMM_LED_PIN, HIGH);
}

void updateLeds() {
  unsigned long now = millis();

  if (WiFi.status() == WL_CONNECTED) {
    wifiLedOn = true;
    digitalWrite(WIFI_LED_PIN, HIGH);
  } else if (now >= wifiBlinkAt) {
    wifiLedOn = !wifiLedOn;
    wifiBlinkAt = now + 500;
    digitalWrite(WIFI_LED_PIN, wifiLedOn ? HIGH : LOW);
  }

  if (now < commUntil) {
    if (now >= commToggleAt) {
      commLedOn = !commLedOn;
      digitalWrite(COMM_LED_PIN, commLedOn ? HIGH : LOW);
      commToggleAt = now + 35;
    }
  } else if (commLedOn) {
    commLedOn = false;
    digitalWrite(COMM_LED_PIN, LOW);
  }
}

void loadConfig() {
  prefs.begin("ve360-tank", false);
  wifiSsid   = cfg("ssid", DEF_WIFI_SSID);
  wifiPass   = cfg("pass", DEF_WIFI_PASS);
  backendUrl = cfg("backend", DEF_BACKEND);
  deviceUid  = cfg("dev", DEF_DEVICE);
  tankId     = cfg("tank", DEF_TANK);
  tankHeightCm   = prefs.getFloat("height", tankHeightCm);
  tankCapacityL  = prefs.getFloat("cap", tankCapacityL);
  jsonEcho   = prefs.getBool("json", true);
}

void printNetwork() {
  bool up = WiFi.status() == WL_CONNECTED;
  Serial.println("---- NETWORK ----");
  Serial.printf("SSID=%s  PASS=%s\n", wifiSsid.c_str(), wifiPass.length() ? "********" : "(empty)");
  Serial.printf("STATUS=%s  IP=%s  RSSI=%d dBm\n", up ? "CONNECTED" : "OFFLINE",
                up ? WiFi.localIP().toString().c_str() : "-", WiFi.RSSI());
  Serial.printf("BACKEND=%s\n", backendUrl.c_str());
  Serial.println("-----------------");
}

void pingBackend() {
  if (WiFi.status() != WL_CONNECTED) { Serial.println("[PING] WiFi offline — type WIFI to retry"); return; }
  HTTPClient http;
  http.begin(backendUrl + "/health");
  http.setConnectTimeout(4000);
  http.setTimeout(6000);
  markBackendActivity(1000);
  int code = http.GET();
  String body = http.getString();
  http.end();
  Serial.printf("[PING] GET /health -> %d  %s\n", code, body.c_str());
}

void ensureWiFi() {
  bool up = WiFi.status() == WL_CONNECTED;
  if (up != wifiWasConnected) {
    wifiWasConnected = up;
    Serial.println(up ? "[WIFI] Connected" : "[WIFI] Link lost — reconnecting");
  }
  if (!up && millis() - lastWifiRetry > 10000) {
    lastWifiRetry = millis();
    Serial.print("[WIFI] Retry ");
    WiFi.reconnect();
    delay(50);
    Serial.printf("status=%d\n", (int)WiFi.status());
  }
}

void connectWiFi() {
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);
  if (wifiSsid.length() == 0 || wifiSsid == "YOUR_WIFI") {
    Serial.println("[WIFI] Not configured. Type: SET WIFI ssid|password");
    return;
  }
  Serial.printf("[WIFI] Connecting to '%s' (backend %s)\n", wifiSsid.c_str(), backendUrl.c_str());
  WiFi.begin(wifiSsid.c_str(), wifiPass.c_str());
  unsigned long started = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - started < 12000) {
    updateLeds();
    delay(500);
    Serial.print(".");
  }
  Serial.println();
  wifiWasConnected = WiFi.status() == WL_CONNECTED;
  if (wifiWasConnected) {
    Serial.print("[WIFI] OK IP="); Serial.println(WiFi.localIP().toString());
  } else {
    Serial.println("[WIFI] Offline — it will retry automatically. READ/LID still work.");
    Serial.println("[WIFI] Check: SSID must be 2.4 GHz, password correct, router near board.");
  }
  printNetwork();
}

void setup() {
  Serial.begin(115200);
  pinMode(WIFI_LED_PIN, OUTPUT); pinMode(COMM_LED_PIN, OUTPUT);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(LIMIT_PIN, INPUT_PULLUP);
  dht.begin();
  loadConfig();
  connectWiFi();
  lastSend = millis();
  Serial.println("READY. Type HELP for commands, CONFIG to see saved IDs.");
}

float readDistanceCm() {
  digitalWrite(TRIG_PIN, LOW);
  delayMicroseconds(4);
  digitalWrite(TRIG_PIN, HIGH);
  delayMicroseconds(12);
  digitalWrite(TRIG_PIN, LOW);
  long duration = pulseIn(ECHO_PIN, HIGH, 30000);
  if (duration == 0) return -1;
  return duration * 0.0343 / 2.0;
}

void readAll() {
  float dist = readDistanceCm();
  levelCm = (dist < 0) ? 0 : constrain(tankHeightCm - dist, 0, tankHeightCm);
  volumeL = tankHeightCm > 0 ? levelCm / tankHeightCm * tankCapacityL : 0;

  float t = dht.readTemperature();
  float h = dht.readHumidity();
  temperatureC = isnan(t) ? 0 : t;
  humidityPct = isnan(h) ? 0 : h;
  lidOpen = digitalRead(LIMIT_PIN) == LOW;
}

void printReading(float distanceCm) {
  Serial.printf("[TANK] distance=%.1fcm level=%.1fcm volume=%.0fL temp=%.1fC hum=%.0f%% lid=%s\n",
                distanceCm, levelCm, volumeL, temperatureC, humidityPct,
                lidOpen ? "OPEN" : "CLOSED");
}

void echoJson(const char* tag, const String& body) {
  if (jsonEcho) Serial.printf("[JSON %s] %s\n", tag, body.c_str());
}

String telemetryJson() {
  StaticJsonDocument<512> doc;
  doc["device_uid"] = deviceUid;
  doc["kind"] = "TANK";
  doc["event_id"] = "TANK" + String(eventNo++);
  doc["tank_id"] = tankId;
  JsonObject r = doc.createNestedObject("readings");
  r["fuel_level_cm"] = levelCm;
  r["fuel_volume_l"] = volumeL;
  r["temperature_c"] = temperatureC;
  r["humidity_pct"] = humidityPct;
  r["lid_open"] = lidOpen;
  r["firmware_version"] = FIRMWARE;
  String out;
  serializeJson(doc, out);
  return out;
}

void sendTelemetry() {
  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("[SEND] Wi-Fi offline — cannot post telemetry.");
    return;
  }
  String body = telemetryJson();
  markBackendActivity(1200);
  HTTPClient http;
  http.begin(backendUrl + "/api/v1/device/prototype/telemetry");
  http.setConnectTimeout(4000);
  http.setTimeout(6000);
  http.addHeader("Content-Type", "application/json");
  int code = http.POST(body);
  String res = http.getString();
  http.end();
  markBackendActivity(600);
  echoJson("OUT", body);
  Serial.printf("[HTTP] telemetry -> %d\n", code);
  echoJson("IN", res);
}

void printConfig() {
  Serial.println("---- SAVED CONFIG ----");
  Serial.printf("WIFI=%s BACKEND=%s\n", wifiSsid.c_str(), backendUrl.c_str());
  Serial.printf("DEVICE=%s TANK=%s\n", deviceUid.c_str(), tankId.c_str());
  Serial.printf("HEIGHT=%.1fcm CAPACITY=%.0fL JSON=%s\n",
                tankHeightCm, tankCapacityL, jsonEcho ? "ON" : "OFF");
  Serial.println("Formula: volume = level / height * capacity");
  Serial.println("----------------------");
}

void applySetting(const String& key, const String& value) {
  if (key == "WIFI") {
    int sep = value.indexOf('|');
    if (sep < 1) { Serial.println("Use: SET WIFI ssid|password"); return; }
    saveCfg("ssid", value.substring(0, sep));
    saveCfg("pass", value.substring(sep + 1));
    wifiSsid = value.substring(0, sep);
    wifiPass = value.substring(sep + 1);
    Serial.println("[SET] Wi-Fi saved. Reconnecting now...");
    WiFi.disconnect(false);
    delay(200);
    connectWiFi();
  } else if (key == "BACKEND") { saveCfg("backend", value); backendUrl = value; }
  else if (key == "DEVICE") { saveCfg("dev", value); deviceUid = value; }
  else if (key == "TANK") { saveCfg("tank", value); tankId = value; }
  else if (key == "HEIGHT") {
    tankHeightCm = value.toFloat();
    if (tankHeightCm <= 0) { Serial.println("ERR: height must be positive"); return; }
    prefs.putFloat("height", tankHeightCm);
  } else if (key == "CAPACITY") {
    tankCapacityL = value.toFloat();
    if (tankCapacityL <= 0) { Serial.println("ERR: capacity must be positive"); return; }
    prefs.putFloat("cap", tankCapacityL);
  } else { Serial.println("Unknown SET key."); return; }
  Serial.println("[SET] " + key + " saved.");
}

void handleSerial(String line) {
  line.trim();
  if (line == "HELP") {
    Serial.println("SET WIFI ssid|pass | SET BACKEND url | SET DEVICE uid | SET TANK id");
    Serial.println("SET HEIGHT cm | SET CAPACITY litres | CONFIG | JSON ON|OFF | REBOOT");
    Serial.println("READ | SEND | STATUS | LID");
    Serial.println("NETWORK | PING | WIFI (retry now) | CONFIG");
  } else if (line.startsWith("SET ")) {
    String rest = line.substring(4);
    int sp = rest.indexOf(' ');
    if (sp < 0) { Serial.println("Use: SET KEY value"); return; }
    applySetting(rest.substring(0, sp), rest.substring(sp + 1));
  } else if (line == "CONFIG") printConfig();
  else if (line == "REBOOT") ESP.restart();
  else if (line.startsWith("JSON ")) {
    jsonEcho = line.substring(5) == "ON";
    prefs.putBool("json", jsonEcho);
    Serial.printf("[JSON] %s\n", jsonEcho ? "ON" : "OFF");
  } else if (line == "READ") {
    float d = readDistanceCm();
    readAll();
    printReading(d);
  } else if (line == "SEND") {
    float d = readDistanceCm();
    readAll();
    printReading(d);
    sendTelemetry();
  } else if (line == "STATUS") {
    Serial.printf("UID=%s TANK=%s LEVEL=%.1fcm VOLUME=%.0fL WIFI=%s\n",
                  deviceUid.c_str(), tankId.c_str(), levelCm, volumeL,
                  WiFi.status() == WL_CONNECTED ? "OK" : "OFF");
  } else if (line == "NETWORK") printNetwork();
  else if (line == "PING") pingBackend();
  else if (line == "WIFI") { WiFi.disconnect(false); delay(200); connectWiFi(); }
  else if (line == "LID") Serial.println(lidOpen ? "LID OPEN" : "LID CLOSED");
  else Serial.println("Unknown command. Type HELP.");
}

void loop() {
  updateLeds();
  ensureWiFi();
  if (Serial.available()) handleSerial(Serial.readStringUntil('\n'));

  if (millis() - lastSend > 15000) {
    lastSend = millis();
    readAll();
    if (WiFi.status() == WL_CONNECTED) sendTelemetry();
  }
  delay(10);
}
